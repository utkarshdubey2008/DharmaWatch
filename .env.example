# ==============================================================================
# The Dharma Watch — Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=3006
NODE_ENV=production
COOKIE_SECURE=false

# Security & Authentication
# Generate a strong 32-byte secret using: openssl rand -hex 32
JWT_SECRET=dharmawatch-super-secret-key-2026-prod

# Domain & Public URLs (Used for OpenGraph, Canonical URLs & RSS Feeds)
PUBLIC_DOMAIN=https://yourdomain.com
SITE_URL=https://yourdomain.com

# Private Documentation Endpoint Route (Excluded from crawlers)
DOCS_ROUTE=/wire-specs-7x9q2p

# Telegram Newsroom Management Bot
# Obtain this HTTP API token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Admin Authorizations (Comma-separated)
# Obtain your numeric User ID from @userinfobot on Telegram
ADMIN_TELEGRAM_IDS=123456789
ADMIN_TELEGRAM_USERNAMES=your_telegram_username

# Filesystem Storage (Optional override, defaults to project root ./data)
# DATA_DIR=/app/data
